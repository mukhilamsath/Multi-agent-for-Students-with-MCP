# ============================================================
# .gitignore — Student Assistant (Strands + Bedrock)
# ============================================================

# ── Credentials & secrets ────────────────────────────────────
# NEVER commit real credentials. Keep .env.example (safe template) in git.
.env
traces
logs

# ── Session data ─────────────────────────────────────────────
# FileSessionManager writes conversation history here at runtime.
# It contains personal chat history and agent state — not source code.
sessions/

# ── Python bytecode & caches ─────────────────────────────────
__pycache__/
*.py[cod]          # .pyc  .pyo  .pyd
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Build / packaging artefacts ──────────────────────────────
build/
dist/
*.egg-info/
*.egg
MANIFEST

# ── Test & coverage output ────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ── IDE / editor folders ──────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS-generated files ────────────────────────────────────────
.DS_Store          # macOS Finder metadata
Thumbs.db          # Windows thumbnail cache
desktop.ini
