# ============================================================
# .env.example — copy this file to .env and fill in your values
# NEVER commit your real .env file to version control
# ============================================================

# ── AWS Credentials ─────────────────────────────────────────
# Get these from the AWS Console → IAM → Users → Security credentials
# Or ask your AWS administrator for a set of access keys.
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# Optional: only needed when using temporary credentials (e.g. AWS SSO, assumed roles)
# AWS_SESSION_TOKEN=your_session_token_here

# ── AWS Region ───────────────────────────────────────────────
# The region where your Bedrock model access is enabled.
# Common choices: us-east-1, us-west-2, eu-west-1
AWS_REGION=us-east-1

# ── Bedrock Model ID ─────────────────────────────────────────
# The model Strands will call via Amazon Bedrock.
# Make sure you have enabled access for this model in the Bedrock console:
# https://console.aws.amazon.com/bedrock → Model access
#
# Recommended for beginners (Claude Sonnet 4 — default Strands model):
BEDROCK_MODEL_ID=amazon.nova-micro-v1:0

# ── Bedrock Guardrails (optional but recommended) ────────────────────────────
# Amazon Bedrock Guardrails add a server-side safety layer that filters harmful
# content, blocks denied topics, detects PII, and defends against prompt
# injection — independently of the LLM itself.
#
# How to create a guardrail (one-time setup):
#   1. Open https://console.aws.amazon.com/bedrock → Guardrails → Create guardrail
#   2. Configure topic denials, content filters, and PII detection as needed
#   3. Click "Create guardrail" — copy the Guardrail ID shown on the detail page
#      (it looks like: abc1234567)
#   4. Use "DRAFT" while testing; create a numbered version (1, 2 …) for prod
#
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# ── OpenTelemetry & Jaeger Tracing ──────────────────────────────────────────
# The system automatically exports traces locally to traces/traces.jsonl.
# To also export traces to a Jaeger collector via OTLP/HTTP:
#
# Quick Docker command to run Jaeger all-in-one locally:
#   docker run -d --name jaeger -p 16686:16686 -p 4318:4318 jaegertracing/all-in-one:latest
#
# Jaeger Web UI:      http://localhost:16686
# Jaeger OTLP Target: http://localhost:4318/v1/traces
#
ENABLE_JAEGER=false
JAEGER_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=student-assistant

